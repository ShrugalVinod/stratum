# Copy to `.env` (gitignored) and fill in values locally. In Colab, use the 🔑 Secrets panel
# with the SAME names instead. Never paste keys into chat, code or notebooks.
# Step-by-step instructions for each account: docs/data_sources.md

# Copernicus Climate Data Store (ERA5). Alternatively ~/.cdsapirc.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# EUMETSAT Data Store (Meteosat-9 IODC) — API consumer key / secret
EUMETSAT_KEY=
EUMETSAT_SECRET=

# OpenSky Network historical database (Trino) — once access is granted
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# GitHub fine-grained token (read-only, this repo only) — needed in COLAB only
GITHUB_TOKEN=

# Secret salt for hashing flight IDs in public web exports (Phase 4). Any long random string.
STRATUM_ID_SALT=

# Optional path overrides (defaults: Colab Drive, or ./data/drive_local on a laptop)
STRATUM_DRIVE_ROOT=
STRATUM_WORK_DIR=
