// Cloudflare Workers static-assets hosting for the STRATUM labelling app (separate from the
// website). Code only: scene packages are opened from the labeller's own laptop, never uploaded.
{
  "name": "stratum-labeller",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
