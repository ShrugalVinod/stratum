// Cloudflare Workers static-assets hosting for the STRATUM website (free tier).
// `npm run build` writes ./dist; every unknown path serves index.html so /map etc. work on refresh.
// worker/index.js runs first only for the live routes: /api/* (aircraft near a point, adsb.lol)
// and /data/outlook/* (the daily forecast build on the `outlook-data` branch).
{
  "name": "stratum",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  // keep variables set in the Cloudflare dashboard (GH_DISPATCH_TOKEN) when a push redeploys;
  // without this every deploy removes a plain-text dashboard variable
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/data/outlook/*", "/data/report/*", "/data/schedule/*"]
  }
}
