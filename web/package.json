{
  "name": "stratum-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "numbers": "node --experimental-strip-types scripts/check_numbers.ts",
    "build:expo": "tsc --noEmit && vite build --outDir expo-build/site --emptyOutDir && node scripts/make_expo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "maplibre-gl": "6.14.0",
    "preact": "11.0.1",
    "preact-iso": "2.12.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@preact/preset-vite": "2.10.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
